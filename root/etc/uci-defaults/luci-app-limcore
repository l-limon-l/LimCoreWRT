#!/bin/sh

[ -f "/www/luci-static/resources/icons/loading.gif" ] && \
	sed -i "s,/loading.svg,/loading.gif,g" "/www/luci-static/resources/view/limcore/status.js"

# Drop the pre-rename firewall includes. They live in /etc/config/firewall, which no
# package owns, so removing luci-app-re-homeproxy leaves them behind pointing at
# /var/run/homeproxy/*.nft — paths this package never creates again. fw4 would then be
# reloading includes whose files are gone.
uci -q batch <<-EOF >"/dev/null"
	delete firewall.homeproxy_pre
	delete firewall.homeproxy_forward
	delete firewall.homeproxy_input
	delete firewall.homeproxy_post
	commit firewall
EOF

# Same for the old dnsmasq drop-in: it carries a conf-dir= line pointing at a directory
# the new layout no longer creates, and dnsmasq refuses to start on a missing conf-dir.
rm -f /tmp/dnsmasq.d/dnsmasq-homeproxy.conf
rm -rf /tmp/dnsmasq.d/dnsmasq-homeproxy.d

uci -q batch <<-EOF >"/dev/null"
	delete firewall.limcore_pre

	delete firewall.limcore_forward
	set firewall.limcore_forward=include
	set firewall.limcore_forward.type=nftables
	set firewall.limcore_forward.path="/var/run/limcore/fw4_forward.nft"
	set firewall.limcore_forward.position="chain-pre"
	set firewall.limcore_forward.chain="forward"

	delete firewall.limcore_input
	set firewall.limcore_input=include
	set firewall.limcore_input.type=nftables
	set firewall.limcore_input.path="/var/run/limcore/fw4_input.nft"
	set firewall.limcore_input.position="chain-pre"
	set firewall.limcore_input.chain="input"

	delete firewall.limcore_post
	set firewall.limcore_post=include
	set firewall.limcore_post.type=nftables
	set firewall.limcore_post.path="/var/run/limcore/fw4_post.nft"
	set firewall.limcore_post.position="table-post"
	commit firewall
EOF

# Keep the app updated unless someone has said otherwise. Only set when the option is
# absent: once it exists it carries the user's answer, including a deliberate '0'.
if [ -z "$(uci -q get limcore.config.app_auto_update)" ]; then
	uci -q batch <<-EOF >"/dev/null"
		set limcore.config.app_auto_update='1'
		set limcore.config.app_auto_update_days='3'
		set limcore.config.app_auto_update_hour='4'
		commit limcore
	EOF
fi

if [ -z "$(uci -q get limcore.config.hwid)" ]; then
	MAC=$(cat /sys/class/net/br-lan/address 2>/dev/null || cat /sys/class/net/eth0/address 2>/dev/null || cat /etc/machine-id 2>/dev/null)
	[ -n "$MAC" ] || MAC="limcore-default-hwid-key"
	HEX=$(echo -n "$MAC" | md5sum | cut -d' ' -f1)
	H1=$(echo "$HEX" | cut -c1-8)
	H2=$(echo "$HEX" | cut -c9-12)
	H3=$(echo "$HEX" | cut -c14-16)
	H4=$(echo "$HEX" | cut -c18-20)
	H5=$(echo "$HEX" | cut -c21-32)
	GEN_HWID="${H1}-${H2}-4${H3}-a${H4}-${H5}"
	uci set limcore.config.hwid="$GEN_HWID"
	uci commit limcore
fi

# Device Control. Set the modes explicitly rather than trusting the ones the package
# carried: git on Windows does not record the executable bit, and luci.mk copies root/
# preserving whatever modes it finds — so a package built from a Windows checkout can
# ship an init script that will not run.
chmod 0755 /etc/init.d/limcore-netpause /usr/share/limcore/scripts/netpause_apply.uc 2>/dev/null

# Adopt the devices from a standalone netpause install, if one is present, so moving to
# the built-in page keeps the names and the paused state instead of starting empty. Only
# runs while LimCore itself has no devices yet, since this file runs again on upgrades.
if [ -f /etc/config/netpause ] && ! uci -q show limcore | grep -q '=device$'; then
	idx=0
	while mac=$(uci -q get "netpause.@device[$idx].mac"); do
		[ -n "$mac" ] || break

		label=$(uci -q get "netpause.@device[$idx].label")
		note=$(uci -q get "netpause.@device[$idx].note")
		paused=$(uci -q get "netpause.@device[$idx].paused")

		sid=$(uci add limcore device)
		uci set "limcore.$sid.mac=$mac"
		[ -n "$label" ] && uci set "limcore.$sid.label=$label"
		[ -n "$note" ] && uci set "limcore.$sid.note=$note"
		[ "$paused" = "1" ] && uci set "limcore.$sid.paused=1"

		idx=$((idx + 1))
	done
	[ "$idx" -gt 0 ] && uci commit limcore
fi

/etc/init.d/limcore-netpause enable >/dev/null 2>&1
/etc/init.d/limcore-netpause start  >/dev/null 2>&1

exit 0
